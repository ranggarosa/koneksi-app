# =============================================================================
# FRONTEND CONFIGURATION (Vite / Client-Side)
# =============================================================================
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# =============================================================================
# BACKEND CONFIGURATION (Firebase Cloud Functions / Google Workspace APIs)
# =============================================================================
# Option 1: Base64-encoded or raw JSON Service Account Key
GOOGLE_SERVICE_ACCOUNT_KEY=

# Option 2: Individual Service Account Email and Private Key (PEM format)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Testing / Simulation mode (set to true for offline mock runs without live GCP keys)
PDF_MOCK_MODE=false
