# Google Workspace Service Account Credentials
# Option 1: Base64-encoded or raw JSON Service Account Key
GOOGLE_SERVICE_ACCOUNT_KEY=

# Option 2: Individual Service Account Email and Private Key (PEM format)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Storage Bucket (optional, defaults to Firebase Admin default bucket)
STORAGE_BUCKET_NAME=koneksi-app-dev.appspot.com

# Testing / Simulation mode (set to true for automated mock runs)
PDF_MOCK_MODE=false
